{
  "app-id": "io.github.liketerminal.LikeTerminal",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "like-terminal",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=ssh-auth",
    "--device=dri",
    "--filesystem=home",
    "--talk-name=org.freedesktop.secrets"
  ],
  "sdk-extensions": [],
  "build-options": {
    "append-path": "/run/rust-cargo/bin",
    "env": {
      "CARGO_HOME": "/run/rust-cargo",
      "RUSTUP_HOME": "/run/rust-rustup",
      "CARGO_NET_OFFLINE": "true"
    },
    "build-args": [
      "--bind-mount=/run/rust-cargo=/home/felipe/.cargo",
      "--bind-mount=/run/rust-rustup=/home/felipe/.rustup"
    ]
  },
  "modules": [
    {
      "name": "vte",
      "buildsystem": "meson",
      "config-opts": [
        "--buildtype=release",
        "-Dgtk3=false",
        "-Dgtk4=true",
        "-Dglade=false",
        "-Dgir=false",
        "-Dvapi=false",
        "-Dlibdir=lib"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/vte/0.84/vte-0.84.0.tar.xz",
          "sha256": "0414e31583836aeb7878da25f67c515f7e8879917ecc37c92e26b83e8d8fc3e3"
        }
      ]
    },
    {
      "name": "like-terminal",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline build --release --locked",
        "install -Dm755 target/release/like-terminal /app/bin/like-terminal",
        "install -Dm644 data/io.github.liketerminal.LikeTerminal.desktop /app/share/applications/io.github.liketerminal.LikeTerminal.desktop",
        "install -Dm644 data/io.github.liketerminal.LikeTerminal.metainfo.xml /app/share/metainfo/io.github.liketerminal.LikeTerminal.metainfo.xml",
        "install -Dm644 data/io.github.liketerminal.LikeTerminal.svg /app/share/icons/hicolor/scalable/apps/io.github.liketerminal.LikeTerminal.svg"
      ],
      "sources": [
        "cargo-sources.json",
        {
          "type": "dir",
          "path": ".",
          "skip": [
            "target",
            ".git",
            "build-dir",
            "flatpak-build",
            ".flatpak-builder"
          ]
        }
      ],
      "build-options": {
        "build-args": [
          "--bind-mount=/run/rust-cargo=/home/felipe/.cargo",
          "--bind-mount=/run/rust-rustup=/home/felipe/.rustup"
        ],
        "append-path": "/run/rust-cargo/bin",
        "env": {
          "CARGO_HOME": "/run/rust-cargo",
          "RUSTUP_HOME": "/run/rust-rustup",
          "CARGO_NET_OFFLINE": "true"
        }
      }
    }
  ]
}
